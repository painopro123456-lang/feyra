<Window x:Class="Feyra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FEYRA" Height="820" Width="1380" MinHeight="560" MinWidth="850"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="48"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="24"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#151820" BorderBrush="#292E39" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="True" Margin="12,0">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
          <TextBlock Text="◈" Foreground="{StaticResource AccentBrush}" FontSize="20" Margin="0,0,9,0"/>
          <TextBlock Text="FEYRA" FontSize="13" FontWeight="Bold" CharacterSpacing="180" VerticalAlignment="Center"/>
          <TextBlock Text="  /  Browse without the noise" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <Button x:Name="HistoryButton" Content="History" Click="History_Click" FontSize="12"/>
          <Button x:Name="DownloadsButton" Content="Downloads" Click="Downloads_Click" FontSize="12"/>
          <Button x:Name="BookmarksButton" Content="Bookmarks" Click="Bookmarks_Click" FontSize="12"/>
          <Button x:Name="SettingsButton" Content="Settings" Click="Settings_Click" FontSize="12"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1" Background="#151820">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="←" Click="Back_Click" ToolTip="Back (Alt+Left)" FontSize="18"/>
      <Button Grid.Column="1" Content="→" Click="Forward_Click" ToolTip="Forward (Alt+Right)" FontSize="18"/>
      <Button Grid.Column="2" Content="↻" Click="Reload_Click" ToolTip="Reload (Ctrl+R)" FontSize="18"/>
      <Border Grid.Column="3" Background="#222630" CornerRadius="11" Margin="8,4" BorderBrush="#343B49" BorderThickness="1">
        <DockPanel>
          <TextBlock Text="⌕" Foreground="{StaticResource MutedBrush}" FontSize="18" Margin="12,0,7,0" VerticalAlignment="Center"/>
          <TextBox x:Name="AddressBox" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0"
                   VerticalContentAlignment="Center" FontSize="13" CaretBrush="White"
                   KeyDown="AddressBox_KeyDown" GotKeyboardFocus="AddressBox_GotKeyboardFocus"
                   ToolTip="Search or enter an address (Ctrl+L)"/>
          <Button Content="☆" Click="BookmarkCurrent_Click" FontSize="18" ToolTip="Bookmark this page"/>
        </DockPanel>
      </Border>
      <Button Grid.Column="4" Content="＋ New tab" Click="NewTab_Click" Margin="4,0" FontSize="12"/>
      <Button Grid.Column="5" Content="Private" Click="NewPrivate_Click" Margin="4,0" FontSize="12"/>
    </Grid>
    <Border Grid.Row="2" Background="#171A21" BorderBrush="#292E39" BorderThickness="0,0,0,1">
      <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0" SelectionChanged="Tabs_SelectionChanged"
                  ItemContainerStyle="{StaticResource {x:Type TabItem}}">
        <TabControl.Resources>
          <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#C7CBD5"/>
            <Setter Property="Background" Value="#20242D"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="4,5,0,5"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                  <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                    <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#343B49"/><Setter Property="Foreground" Value="White"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#2A303B"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </TabControl.Resources>
      </TabControl>
    </Border>
    <Grid Grid.Row="3" x:Name="ContentHost" Background="#FFFFFF"/>
    <Border Grid.Row="4" Background="#171A21" BorderBrush="#292E39" BorderThickness="0,1,0,0">
      <DockPanel Margin="12,0">
        <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
        <TextBlock Text="FEYRA  •  Preview" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" DockPanel.Dock="Right"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
